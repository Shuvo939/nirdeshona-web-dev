# Public site URL (used for sitemap, canonical URLs and email links)
NEXT_PUBLIC_SITE_URL=https://web.nirdeshona.com

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings → Database → Connection string
# Use the "Session pooler" connection string (works well with serverless/Vercel)
DATABASE_URL=

# Resend (transactional email) — resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=you@example.com

# Cloudflare Turnstile (contact form spam protection) — dash.cloudflare.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Crisp (client live chat) — crisp.chat, Settings → Website Settings
NEXT_PUBLIC_CRISP_WEBSITE_ID=

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=nirdeshona-webdev
R2_PUBLIC_URL=https://cdn.nirdeshona.com